# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/montessori_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/montessori_db?schema=public"
# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─────────────────────────────────────────────
# Email (Nodemailer / SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Montessori Platform <no-reply@montessori.app>"

# ─────────────────────────────────────────────
# Cloudinary (file uploads)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────
# Groq AI (AI assistant — NEVER expose to frontend)
# ─────────────────────────────────────────────
GROK_API_KEY=your_groq_api_key
GROK_MODEL=qwen/qwen3.8-27b

# ─────────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.vercel.app

# ─────────────────────────────────────────────
# App URL (used in email links)
# ─────────────────────────────────────────────
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────
# Stripe Payments
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
