<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: sans-serif; line-height: 1.5; color: #333; }
    .header { font-weight: bold; font-size: 1.2em; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 20px; }
    .field { margin-bottom: 10px; }
    .label { font-weight: bold; color: #555; }
    .message { margin-top: 20px; padding: 15px; background: #f9f9f9; border-left: 4px solid #3E4C8C; }
  </style>
</head>
<body>
  <div class="header">New Contact Form Submission</div>
  
  <div class="field">
    <span class="label">Name:</span> <%= name %>
  </div>
  <div class="field">
    <span class="label">Email:</span> <%= email %>
  </div>
  <div class="field">
    <span class="label">School:</span> <%= school || 'N/A' %>
  </div>
  <div class="field">
    <span class="label">Topic:</span> <%= topic %>
  </div>
  
  <div class="message">
    <div class="label">Message:</div>
    <p><%= message %></p>
  </div>
</body>
</html>
